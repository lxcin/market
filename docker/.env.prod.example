# 复制为 docker/.env 用于生产部署（.env 不会被提交）
# 镜像仓库属主（GitHub 用户名/组织）
IMAGE_OWNER=lxcin
IMAGE_TAG=latest

# MySQL / Redis 口令
MYSQL_ROOT_PASSWORD=change-me-strong-password
DB_USERNAME=root
DB_PASSWORD=change-me-strong-password
REDIS_PASSWORD=change-me-strong-password

# JWT 密钥：至少 256 bit（32 字节）的随机字符串
JWT_SECRET=please-change-me-to-a-long-random-secret-at-least-256-bits

# 短信验证码：生产接真实网关后置 false
SMS_MOCK=true

# Elasticsearch 堆内存（按服务器内存调整）
ES_JAVA_OPTS=-Xms512m -Xmx512m
